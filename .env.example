# Local development only. Never commit the real .env file.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/busSystem?retryWrites=true&w=majority
PORT=8000

# Separate database for admin departure feedback (does NOT use busSystem)
DEPARTURE_LOGS_DB_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/departureLogsDB?retryWrites=true&w=majority
